# Add whichever of these you have — the app hides/disables any model whose
# key is missing. You need at least ONE configured to compare, and at least
# ONE configured to get an AI Verdict (the judge feature).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: force a specific provider to act as the judge for the AI Verdict
# feature. If unset, AI Indus picks the first configured provider in this
# priority order: groq, google, anthropic, openai.
JUDGE_PROVIDER=

# Optional: when true, any model without an API key returns a clearly
# labeled sample response instead of an error, so the UI stays demoable.
# Leave unset/false for a real deployment.
DEMO_MODE=false
